          }
        }
      }
    },
    "Strict lock": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 잠금"
          }
        }
      }
    },
    "Strict lock is off for this Block now, so it can be stopped.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지금 차단은 강제 잠금이 꺼져 있어 중지할 수 있습니다."
          }
        }
      }
    },
    "Strict lock is off in Settings, so for now it can be stopped.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 강제 잠금을 꺼 두어 지금은 중지할 수 있습니다."
          }
        }
      }
    },
    "Strict lock is off in Settings, so for now this block can be stopped.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 강제 잠금을 꺼 두어 지금은 이 차단을 중지할 수 있습니다."
          }
        }
      }
    },
    "Strict lock is off in Settings. This block was active when you turned it off, so it stays strict until %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 강제 잠금이 꺼져 있습니다. 강제 잠금을 끌 때 이 차단이 실행 중이었으므로 %@까지 강제 잠금이 유지됩니다."
          }
        }
      }
    },
    "Strict lock is off. Blocks running now stay strict until they reset or end.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 잠금이 꺼져 있습니다. 현재 실행 중인 차단은 초기화되거나 끝날 때까지 강제 잠금이 유지됩니다."
          }
        }
      }
    },
    "Strict lock is off: blocks can be stopped. One that was running or counting when you turned it off stays strict until its own reset, or until it ends.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 잠금이 꺼져 있어 차단을 중지할 수 있습니다. 강제 잠금을 끌 때 이미 실행 중이거나 사용 시간을 계산 중이던 차단은 각각 초기화되거나 끝날 때까지 강제 잠금이 유지됩니다."
          }
        }
      }
    },
    "Strict until %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 강제 잠금"
          }
        }
      }
    },
    "Study, Sleep, Work…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공부, 수면, 업무…"
          }
        }
      }
    },
    "Take a break of": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 시간"
          }
        }
      }
    },
    "Tap “Lock Screen Time Settings” (or “Use Screen Time Passcode”) and hand your friend the phone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘스크린 타임 설정 잠그기’(또는 ‘스크린 타임 암호 사용’)를 탭한 다음 친구에게 iPhone을 건네세요."
          }
        }
      }
    },
    "That block is longer than iOS allows.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 허용하는 시간보다 차단 시간이 깁니다."
          }
        }
      }
    },
    "That doesn't look like a website address.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트 주소 형식이 아닌 것 같습니다."
          }
        }
      }
    },
    "The apps open now and the count starts over.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다시 열리고 사용 시간이 처음부터 다시 계산됩니다."
          }
        }
      }
    },
    "The apps open now.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다시 열립니다."
          }
        }
      }
    },
    "The apps open now. It starts again the next time you arrive.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다시 열립니다. 다음에 도착하면 차단이 다시 시작됩니다."
          }
        }
      }
    },
    "The apps open until %@. Then the limit starts again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 앱을 사용할 수 있습니다. 이후 한도가 다시 시작됩니다."
          }
        }
      }
    },
    "The block is stopped.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단이 중지되었습니다."
          }
        }
      }
    },
    "The break for %@ is over.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 휴식이 끝났습니다."
          }
        }
      }
    },
    "The break is over.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식이 끝났습니다."
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마"
          }
        }
      }
    },
    "This Block now has Strict lock, so it can't be stopped. It ends on its own.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지금 차단에는 강제 잠금이 적용되어 중지할 수 없습니다. 설정한 시간이 되면 자동으로 끝납니다."
          }
        }
      }
    },
    "This Block now has Strict lock. It can't be stopped early.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지금 차단에는 강제 잠금이 적용되어 일찍 중지할 수 없습니다."
          }
        }
      }
    },
    "This block ends on its own.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단은 자동으로 끝납니다."
          }
        }
      }
    },
    "This block ends on its own. If it should be over, open Arc Lock to refresh.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단은 자동으로 끝납니다. 이미 끝났어야 한다면 Arc Lock을 열어 상태를 새로 고치세요."
          }
        }
      }
    },
    "This block ends when you leave.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 떠나면 이 차단이 끝납니다."
          }
        }
      }
    },
    "This block has Strict lock. It can't be stopped while it runs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단에는 강제 잠금이 적용되어 실행 중에 중지할 수 없습니다."
          }
        }
      }
    },
    "This block is running. It can't be changed until %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단이 실행 중입니다. %@까지 변경할 수 없습니다."
          }
        }
      }
    },
    "This block runs until you leave. It can't be changed before then.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단은 장소를 떠날 때까지 실행됩니다. 그전에는 변경할 수 없습니다."
          }
        }
      }
    },
    "This block starts as soon as you save it and lasts %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하는 즉시 시작해 %@ 동안 실행됩니다."
          }
        }
      }
    },
    "This block starts as soon as you save it and lasts until you leave.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하는 즉시 시작해 장소를 떠날 때까지 실행됩니다."
          }
        }
      }
    },
    "This block starts right away": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단은 바로 시작됩니다"
          }
        }
      }
    },
    "This block will be deleted at %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 차단은 %@에 삭제됩니다."
          }
        }
      }
    },
    "This limit is locked in until it resets. One stricter change applies now; anything else — more time, fewer apps or days, the reset time, deleting, or a second change — starts at %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한도는 초기화될 때까지 고정됩니다. 한 번은 더 제한적으로 바로 바꿀 수 있습니다. 그 밖의 변경(시간 늘리기, 앱이나 요일 줄이기, 초기화 시각 변경, 삭제, 두 번째 변경)은 %@부터 적용됩니다."
          }
        }
      }
    },
    "This limit is used up": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한도를 모두 사용했습니다"
          }
        }
      }
    },
    "This limit is used up. It can't be changed until %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한도를 모두 사용했습니다. %@까지 변경할 수 없습니다."
          }
        }
      }
    },
    "This limit is used up. It unlocks at %@.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한도를 모두 사용했습니다. %@에 잠금이 해제됩니다."
          }
        }
      }
    },
    "This time-out is locked in until it resets. A longer break or more days apply now; any other change — the minutes of use, the apps, a shorter break, the reset time, deleting — starts at %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 타임아웃은 초기화될 때까지 고정됩니다. 휴식 시간을 늘리거나 요일을 추가하는 변경은 바로 적용됩니다. 그 밖의 변경(사용 시간, 앱, 휴식 시간 단축, 초기화 시각 변경, 삭제)은 %@부터 적용됩니다."
          }
        }
      }
    },
    "This time-out is on a break. It can't be changed until %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 타임아웃은 휴식 중입니다. %@까지 변경할 수 없습니다."
          }
        }
      }
    },
    "Through %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지"
          }
        }
      }
    },
    "Time for a %@ break. Back at %@.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 휴식 시간입니다. %@에 다시 사용할 수 있습니다."
          }
        }
      }
    },
    "Time for a break": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 시간입니다"
          }
        }
      }
    },
    "Time in these apps and websites adds up toward each break.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱과 웹사이트에서 사용한 시간을 합산해 휴식 주기에 반영합니다."
          }
        }
      }
    },
    "Time in these apps and websites adds up toward one daily limit.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱과 웹사이트에서 사용한 시간을 합산해 하루 사용 한도에 반영합니다."
          }
        }
      }
    },
    "Time left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 시간"
          }
        }
      }
    },
    "Time-out": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임아웃"
          }
        }
      }
    },
    "Time-outs": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임아웃"
          }
        }
      }
    },
    "To": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료"
          }
        }
      }
    },
    "To work while Arc Lock is closed, place blocks need location access set to “Always”. iOS asks in two steps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Lock이 닫혀 있어도 장소 차단이 작동하려면 위치 접근을 ‘항상’으로 설정해야 합니다. iOS가 두 단계로 요청합니다."
          }
        }
      }
    },
    "Together your schedules would leave less than an hour a day free. Keep a free hour, so you can always open Arc Lock and change them.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 모두 설정하면 하루에 자유 시간이 1시간도 남지 않습니다. 언제든 Arc Lock을 열어 일정을 바꿀 수 있도록 하루에 1시간은 비워 두세요."
          }
        }
      }
    },
    "Too many blocks for iOS to watch. Delete one.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 설정할 수 있는 차단 수를 초과했습니다. 차단 하나를 삭제하세요."
          }
        }
      }
    },
    "Turns off at %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 꺼짐"
          }
        }
      }
    },
    "Type %@ to confirm": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하려면 %@ 입력"
          }
        }
      }
    },
    "Unlocked": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 해제됨"
          }
        }
      }
    },
    "Unlocks when you leave": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 떠나면 잠금 해제"
          }
        }
      }
    },
    "Until %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지"
          }
        }
      }
    },
    "Until you leave": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠날 때까지"
          }
        }
      }
    },
    "Up next": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 차단"
          }
        }
      }
    },
    "Use my location": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치 사용"
          }
        }
      }
    },
    "Used up": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 사용"
          }
        }
      }
    },
    "Website": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트"
          }
        }
      }
    },
    "Website time counts in Safari and in browsers that share it with Screen Time (turn that on in the browser's settings).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트 사용 시간은 Safari와 스크린 타임에 사용 시간을 공유하도록 설정한 브라우저에서 계산됩니다. 이 설정은 브라우저에서 켤 수 있습니다."
          }
        }
      }
    },
    "Websites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트"
          }
        }
      }
    },
    "Websites by address": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소로 웹사이트 차단"
          }
        }
      }
    },
    "Websites picked here are blocked in Safari. To block a site in every browser, also add it by address below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 선택한 웹사이트는 Safari에서 차단됩니다. 모든 브라우저에서 차단하려면 아래에 사이트 주소도 추가하세요."
          }
        }
      }
    },
    "Weekdays": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주중"
          }
        }
      }
    },
    "Weekends": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주말"
          }
        }
      }
    },
    "When": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간"
          }
        }
      }
    },
    "When I leave": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "떠날 때"
          }
        }
      }
    },
    "When iOS asks for an Apple Account to recover the passcode, your friend enters their own. Don't skip this: a passcode nobody can recover can mean erasing the iPhone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 암호 복구용 Apple 계정을 요청하면 친구가 자신의 계정을 입력해야 합니다. 이 단계를 건너뛰지 마세요. 암호를 복구할 수 없으면 iPhone을 초기화해야 할 수도 있습니다."
          }
        }
      }
    },
    "When the time is used up, these apps lock until %@. A new limit starts counting when you save it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 시간을 다 쓰면 이 앱들이 %@까지 잠깁니다. 새 한도는 저장하는 순간부터 시간을 계산합니다."
          }
        }
      }
    },
    "When you arrive": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착하면"
          }
        }
      }
    },
    "While it runs, it can't be stopped, loosened or deleted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중에는 중지하거나 완화하거나 삭제할 수 없습니다."
          }
        }
      }
    },
    "Will be deleted at %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 삭제 예정"
          }
        }
      }
    },
    "You can change it in Settings › Arc Lock › Location.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › Arc Lock › 위치에서 변경할 수 있습니다."
          }
        }
      }
    },
    "You can stop it any time.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 멈출 수 있습니다."
          }
        }
      }
    },
    "You can stop it or change it any time.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 멈추거나 바꿀 수 있습니다."
          }
        }
      }
    },
    "You're locked in through %@. Rules can't be changed until then.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 규칙이 고정됩니다. 그때까지 규칙을 변경할 수 없습니다."
          }
        }
      }
    },
    "You're there now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이 장소에 있습니다"
          }
        }
      }
    },
    "Your changes start at %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 %@부터 적용됩니다"
          }
        }
      }
    },
    "for %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 동안"
          }
        }
      }
    },
    "iOS lets one app watch only so many blocks: up to %lld, and a time-out counts as two. Delete one first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 한 앱에 설정할 수 있는 차단은 최대 %lld개입니다. 타임아웃 하나는 2개로 계산됩니다. 차단 하나를 먼저 삭제하세요."
          }
        }
      }
    },
    "iOS lets one app watch up to %lld places in all. Remove a place first.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 한 앱에 추가할 수 있는 장소는 모두 합쳐 최대 %lld곳입니다. 장소 하나를 먼저 삭제하세요."
          }
        }
      }
    },
    "iOS notices arriving and leaving within a few minutes. A bigger circle works more reliably.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 도착과 출발을 감지하기까지 몇 분 정도 걸릴 수 있습니다. 범위를 넓게 설정할수록 더 안정적으로 작동합니다."
          }
        }
      }
    },
    "iOS shows a short message when the icon changes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 변경하면 iOS에서 짧은 알림이 표시됩니다."
          }
        }
      }
    },
    "midnight": {
