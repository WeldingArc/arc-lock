      }
    },
    "It starts again on its own next time.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음번에는 자동으로 다시 시작됩니다."
          }
        }
      }
    },
    "It stays off until %@ and starts again on its own next time.": {
      "localizations": {
