            "state": "translated",
            "value": "소스 코드 (MIT)"
          }
        }
      }
    },
    "Start": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작"
          }
        }
      }
    },
    "Start — can't be stopped": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 · 중지할 수 없음"
          }
        }
      }
    },
    "Starts %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시작"
          }
        }
      }
    },
    "Starts in 5 minutes, at %@.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분 뒤 %@에 시작됩니다."
          }
        }
      }
    },
    "Starts when you arrive at any of these places on a selected day, and ends %@ later, even if you leave sooner. iOS notices arriving within a few minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일에 지정한 장소 중 한 곳에 도착하면 시작되고 %@ 후에 끝납니다. 그 전에 떠나도 차단은 계속됩니다. iOS가 도착을 감지하기까지 몇 분 정도 걸릴 수 있습니다."
          }
        }
      }
    },
    "Starts when you arrive at any of these places on a selected day, and ends when you've left them all (after 12 hours at the latest). iOS notices arriving and leaving within a few minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일에 지정한 장소 중 한 곳에 도착하면 시작되고, 모든 장소를 떠나면 끝납니다(늦어도 12시간 후). iOS가 도착과 출발을 감지하기까지 몇 분 정도 걸릴 수 있습니다."
          }
        }
      }
    },
    "Starts when you arrive on a selected day and ends %@ later, even if you leave sooner. iOS notices arriving within a few minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일에 도착하면 시작되고 %@ 후에 끝납니다. 그 전에 떠나도 차단은 계속됩니다. iOS가 도착을 감지하기까지 몇 분 정도 걸릴 수 있습니다."
          }
        }
      }
    },
    "Starts when you arrive on a selected day and ends when you leave (after 12 hours at the latest). iOS notices arriving and leaving within a few minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일에 도착하면 시작되고, 떠나면 끝납니다(늦어도 12시간 후). iOS가 도착과 출발을 감지하기까지 몇 분 정도 걸릴 수 있습니다."
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지"
          }
        }
      }
    },
    "Stop %@?": {
