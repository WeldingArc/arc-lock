          "stringUnit": {
            "state": "translated",
            "value": "이 차단을 중지할까요?"
          }
        }
      }
    },
    "Stop until %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 중지"
          }
        }
      }
    },
    "Stop until it resets": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도가 초기화될 때까지 중지"
