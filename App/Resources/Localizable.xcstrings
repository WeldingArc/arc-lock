            "value": "%lld일"
          }
        }
      }
    },
    "+%lld": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+%lld"
          }
        }
      }
    },
    "1 minute until a %@ break.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 휴식까지 1분 남았습니다."
          }
        }
      }
    },
    "5 minutes left.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5분 남았습니다."
          }
        }
      }
    },
    "A Block now session is already running until %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단이 %@까지 실행 중입니다."
          }
        }
      }
    },
    "A block can last at most 22 hours, so there's always time to change it between windows.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단은 최대 22시간까지 설정할 수 있습니다. 차단 사이에 설정을 바꿀 시간을 남겨 두기 위해서입니다."
          }
        }
      }
    },
    "A block must last at least 15 minutes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 시간은 15분 이상이어야 합니다."
          }
        }
      }
    },
    "A lock-in can be made longer, never shorter.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙 고정 기간은 늘릴 수 있지만 줄일 수는 없습니다."
          }
        }
      }
    },
    "A place block needs your location. Arc Lock watches only the places you choose, to start a block when you arrive and end it when you leave. Arc Lock never sends your location anywhere.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 차단을 사용하려면 위치 접근이 필요합니다. Arc Lock은 선택한 장소만 확인해 도착하면 차단을 시작하고, 떠나면 끝냅니다. Arc Lock은 위치 정보를 어디에도 전송하지 않습니다."
          }
        }
      }
    },
    "A quiet notice before a block starts, a daily limit runs out, or a break begins.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 시작 전, 일일 한도가 끝나기 전, 휴식이 시작되기 전에 미리 알려 줍니다."
          }
        }
      }
    },
    "A strict block can't be stopped while it runs, and Arc Lock can't be deleted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 잠금이 켜진 차단은 실행 중에 중지할 수 없으며 Arc Lock도 삭제할 수 없습니다."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가"
          }
        }
      }
    },
    "Add a block": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 추가"
          }
        }
      }
    },
    "Add another place": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 추가"
          }
        }
      }
    },
    "After %@ of use, these apps lock for %@. Then they open again and the count starts over. It all starts fresh at %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "After %1$@ of use, these apps lock for %2$@. Then they open again and the count starts over. It all starts fresh at %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 사용하면 이 앱들이 %2$@ 동안 잠깁니다. 이후 다시 사용할 수 있고 사용 시간도 새로 계산됩니다. %3$@에 새 주기가 시작됩니다."
          }
        }
      }
    },
    "After a set time": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정해진 시간 후"
          }
        }
      }
    },
    "After a stretch of use, a short break. Then they open again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한동안 사용하면 잠시 휴식한 뒤 다시 사용할 수 있습니다."
          }
        }
      }
    },
    "After a stretch of use, apps take a short break, then open again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한동안 사용하면 앱이 잠시 잠겼다가 다시 열립니다."
          }
        }
      }
    },
    "After the time you allow each day, apps lock until the limit resets.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 사용 한도를 다 쓰면 한도가 초기화될 때까지 앱이 잠깁니다."
          }
        }
      }
    },
    "After the time you allow, they lock until the limit resets.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용된 시간을 다 쓰면 한도가 초기화될 때까지 앱이 잠깁니다."
          }
        }
      }
    },
    "After this much use": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이만큼 사용 후"
          }
        }
      }
    },
    "All used. Locked until %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도를 모두 사용했습니다. %@까지 잠깁니다."
          }
        }
      }
    },
    "App icon": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 아이콘"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양"
          }
        }
      }
    },
    "Apple keeps what you use on this iPhone — Arc Lock never sees app names or your browsing, and sends nothing anywhere.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 기록은 Apple이 이 iPhone에 보관합니다. Arc Lock은 사용 중인 앱이나 방문한 웹사이트를 알 수 없으며, 어떤 정보도 외부로 보내지 않습니다."
          }
        }
      }
    },
    "Apps & websites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 및 웹사이트"
          }
        }
      }
    },
    "Arc Lock": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Lock"
          }
        }
      }
    },
    "Arc Lock %@ · Open source, no account, no ads.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Lock %@ · 오픈 소스 · 계정과 광고 없음"
          }
        }
      }
    },
    "Arc Lock blocks apps through Apple's Screen Time. Without access, none of your blocks can run.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Lock은 Apple의 스크린 타임을 통해 앱을 차단합니다. 접근 권한이 없으면 차단을 실행할 수 없습니다."
          }
        }
      }
    },
    "Arc Lock blocks apps through Apple's Screen Time. iOS will ask for your Face ID or passcode.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Arc Lock은 Apple의 스크린 타임을 통해 앱을 차단합니다. iOS에서 Face ID 또는 암호를 요청합니다."
          }
        }
      }
    },
    "Ask a friend to hold a passcode": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구에게 암호 맡기기"
          }
        }
      }
    },
    "Back at %@.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 다시 사용할 수 있습니다."
          }
        }
      }
    },
    "Before a block starts, a daily limit runs out, or a time-out's break begins.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단 시작 전, 일일 한도가 끝나기 전, 휴식이 시작되기 전에 알려 줍니다."
          }
        }
      }
    },
    "Block": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단"
          }
        }
      }
    },
    "Block for %@?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 동안 차단하시겠습니까?"
          }
        }
      }
    },
    "Block now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단"
          }
        }
      }
    },
    "Block now is running": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단 실행 중"
          }
        }
      }
    },
    "Block now is stopped.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단을 중지했습니다."
          }
        }
      }
    },
    "Block now isn't running.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단이 실행되고 있지 않습니다."
          }
        }
      }
    },
    "Blocked in Safari and every other browser while Block now runs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단이 실행되는 동안 Safari를 포함한 모든 브라우저에서 차단됩니다."
          }
        }
      }
    },
    "Blocked in Safari and every other browser while the block runs. While a site is blocked, private browsing is off.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단이 실행되는 동안 Safari를 포함한 모든 브라우저에서 차단됩니다. 웹사이트가 차단된 동안에는 비공개 브라우징을 사용할 수 없습니다."
          }
        }
      }
    },
    "Blocked in Safari and every other browser. While a site is blocked, private browsing is off.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari를 포함한 모든 브라우저에서 차단됩니다. 웹사이트가 차단된 동안에는 비공개 브라우징을 사용할 수 없습니다."
          }
        }
      }
    },
    "Blocked in every browser during each break. To count time on a site, also pick it above.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴식 시간에는 모든 브라우저에서 차단됩니다. 웹사이트 사용 시간도 집계하려면 위에서 해당 사이트를 선택하세요."
          }
        }
      }
    },
    "Blocked in every browser once the time is used up. To count time on a site, also pick it above.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 시간을 다 쓰면 모든 브라우저에서 차단됩니다. 웹사이트 사용 시간도 집계하려면 위에서 해당 사이트를 선택하세요."
          }
        }
      }
    },
    "Blocked until %@.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@까지 차단됩니다."
          }
        }
      }
    },
    "Blocked until you leave.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 떠날 때까지 차단됩니다."
          }
        }
      }
    },
    "Blocking now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단 중"
          }
        }
      }
    },
    "Blocks": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단"
          }
        }
      }
    },
    "Blocks set to Strict lock can't be stopped, loosened or deleted while they run. Turning it off works right away; a block that's running or counting stays strict until its own reset, or until it ends.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 잠금이 켜진 차단은 실행 중에 중지하거나 완화하거나 삭제할 수 없습니다. 설정에서 강제 잠금을 꺼도 이미 실행 중이거나 사용 시간을 계산 중인 차단은 해당 차단이 초기화되거나 끝날 때까지 강제 잠금이 유지됩니다."
          }
        }
      }
    },
    "Blocks with Strict lock can't be changed or stopped while they run. With deletion protection on, no app can be deleted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 잠금이 켜진 차단은 실행 중에 변경하거나 중지할 수 없습니다. 삭제 방지를 켜면 앱을 삭제할 수 없습니다."
          }
