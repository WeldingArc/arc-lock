      }
    },
    "%@ used today": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %@ 사용"
          }
        }
      }
    },
    "%@ used today · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ used today · %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 %1$@ 사용 · %2$@"
          }
        }
      }
    },
    "%@, overnight — it ends the next morning.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@부터 밤새 이어져 다음 날 아침에 끝납니다."
          }
        }
      }
    },
