{
  "sourceLanguage": "en",
  "strings": {
    "%@ + %lld more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ + %2$lld more"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 외 %2$lld개 더"
          }
        }
      }
    },
    "%@ a day · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ a day · %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 %1$@ · %2$@"
          }
        }
      }
    },
    "%@ break after %@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ break after %2$@ · %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 사용 후 %1$@ 휴식 · %3$@"
          }
        }
      }
    },
    "%@ each selected day.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일마다 %@ 동안 차단됩니다."
          }
        }
      }
    },
    "%@ icon": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 아이콘"
          }
        }
      }
    },
    "%@ is stopped.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 차단이 중지되었습니다."
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 남음"
          }
        }
      }
    },
    "%@ since %@": {
      "localizations": {
