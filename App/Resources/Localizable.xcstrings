      }
    },
    "Save and start": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장하고 시작"
          }
        }
      }
    },
    "Saved. It takes effect at %@. Until then the current version runs.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장했습니다. %@부터 적용됩니다. 그전까지는 현재 설정이 유지됩니다."
          }
        }
      }
    },
    "Schedule": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정"
          }
        }
      }
    },
    "Schedules": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정"
          }
        }
      }
    },
    "Screen Time access": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 접근"
          }
        }
      }
    },
    "Screen Time access is off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 접근 꺼짐"
          }
        }
      }
    },
    "Screen Time access is off. Turn it on again to keep blocking.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 접근이 꺼져 있습니다. 차단을 계속하려면 다시 켜세요."
          }
        }
      }
    },
    "Screen Time access wasn't granted. Arc Lock can't block anything without it.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크린 타임 접근이 허용되지 않았습니다. 이 권한이 없으면 Arc Lock에서 차단을 설정할 수 없습니다."
          }
        }
      }
    },
    "Search for a place": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소 검색"
          }
        }
      }
    },
    "Search, or tap the map where the block should start.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색하거나 지도에서 차단을 시작할 장소를 선택하세요."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정"
          }
        }
      }
    },
    "Shorts, Reels, Games…": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쇼츠, 릴스, 게임…"
          }
