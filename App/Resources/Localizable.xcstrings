          "stringUnit": {
            "state": "translated",
            "value": "%@ 차단을 중지할까요?"
          }
        }
      }
    },
    "Stop Block now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 차단 중지"
          }
        }
      }
    },
    "Stop Block now?": {
      "localizations": {
