          "stringUnit": {
            "state": "translated",
            "value": "초기화 시각"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장"
          }
        }
      }
    },
    "Save and lock until %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
